# Sao chép thành .env (KHÔNG đưa .env vào git) rồi đổi các giá trị bên dưới.

# Khoá ký cookie phiên đăng nhập – chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien

# Tài khoản demo (tên đăng nhập: admin, analyst). Để trống = tắt tài khoản.
ADMIN_PASSWORD=admin-demo-2244
ANALYST_PASSWORD=analyst-demo-2244

# Chế độ demo: hiện nút "Xem với vai trò…" để chuyển vai trò không cần mật khẩu.
# Chỉ bật cho bản trình diễn (Vercel tự bật khi không có DATABASE_URL).
DEMO_MODE=false
